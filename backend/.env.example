# RazorRecover Backend Environment Configuration

# Gemini API Key (Required for live AI reasoning)
GEMINI_API_KEY=

# Razorpay Test Mode Credentials (Optional: dual adapter uses mock if left blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Auth / Cloud Settings (Optional: local dev unauthenticated fallback enabled)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server Config
PORT=5000
FRONTEND_URL=http://localhost:3000
RAZORRECOVER_ALLOW_UNAUTHENTICATED=1
