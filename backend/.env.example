# RazorRecover Backend Environment Configuration

# --- AI Engine (Required for live Gemini root-cause diagnosis) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Razorpay Test Mode Credentials ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- PostgreSQL Relational Database ---
# Format: postgresql://username:password@hostname:5432/database_name
# If left blank, defaults to local SQLite fallback at backend/data/razorrecover.db
DATABASE_URL=postgresql://postgres.pguezjvedcuhrizvofnz:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# --- Cryptography & JWT Security ---
SECRET_KEY=your-fernet-master-encryption-key-here
JWT_SECRET_KEY=your-jwt-signing-secret-key-here

# --- Server & Network Config ---
PORT=5000
FRONTEND_URL=http://localhost:3000
